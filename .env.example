# PlanWise Environment Configuration Template
# Copy this file to .env to configure optional cloud integrations.
# By default, PlanWise operates with a robust persistent local offline database
# and deterministic expert AI planning engines out of the box.

# Supabase PostgreSQL & Auth Credentials (Optional)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI Provider API Keys (Optional - fallbacks to built-in expert engine if blank)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_OPENAI_API_KEY=your-openai-api-key-here

# Official WhatsApp Business Cloud API (Optional - fallbacks to Click-to-Chat wa.me links if blank)
VITE_WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
VITE_WHATSAPP_ACCESS_TOKEN=your-meta-cloud-system-user-access-token
